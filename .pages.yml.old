media:
  input: static/images
  output: /images

content:
  - name: posts
    label: یادداشت‌ها
    type: collection
    path: content/posts
    # ----------------------------------------------------
    # Explicitly naming the file index.md inside the folder
    # ----------------------------------------------------
    filename: "{{slug}}/index.md" 
    format: yaml-frontmatter
    media:
      input: content/posts/{{slug}}
      output: "" 
    fields:
      - name: title
        label: Title
        type: string
        required: true
      - name: date
        label: Date
        type: date
        required: true
      - name: author
        label: Author
        type: string
      - name: description
        label: Description
        type: text
      - name: tags
        label: Tags
        type: string
        list: true
      - name: draft
        label: Draft
        type: boolean
      - name: cover
        label: Cover Image Options
        type: object
        fields:
          - name: image
            label: Image (Uploads to post folder)
            type: image
          - name: alt
            label: Alt Text
            type: string
          - name: caption
            label: Caption
            type: string
          - name: relative
            label: Relative
            type: boolean
            default: true
          - name: hidden
            label: Hidden
            type: boolean
      - name: body
        label: Content
        type: rich-text